---
import Layout from '../layouts/Layout.astro'
---

<Layout>
<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-8 flex-1 flex flex-col min-h-0">

  <!-- Header -->
  <header class="flex items-center justify-between py-5 border-b z-50
    border-sage-pale dark:border-navy-lighter bg-mint-light/80 dark:bg-navy/80 backdrop-blur-md">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 -rotate-2 hover:rotate-0 transition-transform flex items-center justify-center">
        <img src="/kakka.png" alt="Kakka" class="w-full h-full object-cover" />
      </div>
      <span class="font-display text-xl font-bold text-navy dark:text-mint tracking-tight">Kakka</span>
    </div>
    <div class="flex items-center gap-2">
      <button id="fontToggle" aria-label="Font size"
        class="w-8 h-8 rounded-lg bg-white dark:bg-navy-light text-slate dark:text-sage
        flex items-center justify-center text-sm hover:scale-105 transition-all shadow-sm dark:shadow-none
        border border-sage-pale dark:border-navy-lighter cursor-pointer font-bold">
        Aa
      </button>
      <button id="themeToggle" aria-label="Toggle theme"
        class="w-8 h-8 rounded-lg bg-white dark:bg-navy-light text-slate dark:text-sage
        flex items-center justify-center text-sm hover:scale-105 transition-all shadow-sm dark:shadow-none
        border border-sage-pale dark:border-navy-lighter cursor-pointer">
        <svg id="moonIcon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg id="sunIcon" class="hidden dark:block" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
      </button>
      <div class="relative">
        <button id="userBtn" aria-label="User menu"
          class="w-8 h-8 rounded-full bg-sage text-white text-xs font-semibold flex items-center justify-center
          hover:scale-105 transition-transform cursor-pointer shadow-sm shadow-sage/25">A</button>
        <div id="userDrop" class="dropdown hidden absolute right-0 top-full mt-2 w-44 rounded-xl p-1.5 z-50
          bg-white dark:bg-navy-light shadow-lg dark:shadow-xl
          border border-sage-pale dark:border-navy-lighter">
          <button id="clearAllBtn" class="w-full flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs
            text-slate dark:text-sage hover:bg-mint/50 dark:hover:bg-navy-lighter/40 transition-colors cursor-pointer">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1H4a2 2 0 0 0-1 1v9a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8z"/><path d="M7 7V4a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v3"/></svg>
            Archived
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- Tabs + Actions -->
  <div class="flex flex-col sm:flex-row sm:items-center gap-3 py-4">
    <div class="inline-flex rounded-xl p-1 bg-sage-pale/60 dark:bg-navy-lighter/50">
      <button data-tab="list" class="tab-btn active text-xs font-medium px-4 py-2 rounded-lg flex items-center gap-1.5 transition-all cursor-pointer
        text-navy dark:text-mint bg-white dark:bg-navy shadow-sm">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        Todos
      </button>
      <button data-tab="kanban" class="tab-btn text-xs font-medium px-4 py-2 rounded-lg flex items-center gap-1.5 transition-all cursor-pointer
        text-slate dark:text-sage-light">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        Kanban
      </button>
      <button data-tab="graph" class="tab-btn text-xs font-medium px-4 py-2 rounded-lg flex items-center gap-1.5 transition-all cursor-pointer
        text-slate dark:text-sage-light">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="6" r="2"/><circle cx="19" cy="6" r="2"/><circle cx="12" cy="18" r="2"/><line x1="5" y1="8" x2="12" y2="16"/><line x1="19" y1="8" x2="12" y2="16"/><line x1="7" y1="6" x2="17" y2="6"/></svg>
        Graph
      </button>
      <button data-tab="chat" class="tab-btn text-xs font-medium px-4 py-2 rounded-lg flex items-center gap-1.5 transition-all cursor-pointer
        text-slate dark:text-sage-light">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        Chat
      </button>
    </div>
    <div class="sm:ml-auto flex items-center gap-3">
      <span class="text-[11px] font-medium text-slate dark:text-sage-dark">
        <span id="totalCount" class="text-navy dark:text-sage font-semibold">0</span> tasks
        <span id="archivedBadge" class="hidden text-[10px] ml-1 px-1.5 py-0.5 rounded-full bg-sage/15 text-sage-dark dark:bg-sage/20 dark:text-sage-light">archived</span>
      </span>
      <!-- Filter toggle -->
      <button id="filterToggle" class="text-xs font-medium px-3 py-2 rounded-lg cursor-pointer transition-colors
        text-slate dark:text-sage-light bg-mint/50 dark:bg-navy-lighter/40
        hover:bg-mint dark:hover:bg-navy-lighter/60
        border border-sage-pale dark:border-navy-lighter/40
        flex items-center gap-1.5">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
        Filter
      </button>
      <button id="addBtn"
        class="text-xs font-medium px-4 py-2 rounded-lg bg-sage text-navy hover:bg-sage-dark transition-colors cursor-pointer
        shadow-sm shadow-sage/20 flex items-center gap-1.5">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
        New Task
      </button>
    </div>
  </div>

  <!-- Filter Bar (hidden by default) -->
  <div id="filterBar" class="hidden mb-4 p-3 rounded-xl bg-white dark:bg-navy-light border border-sage-pale/60 dark:border-navy-lighter/30 shadow-sm dark:shadow-none fade-up">
    <div class="flex flex-wrap items-center gap-2">
      <div class="relative">
        <button id="tagDropdownBtn" class="text-[10.5px] font-semibold uppercase tracking-wider text-slate dark:text-sage-light flex items-center gap-1 px-2.5 py-1.5 rounded-lg border border-sage-pale dark:border-navy-lighter/50 bg-mint/50 dark:bg-navy-lighter/50 hover:bg-sage-pale dark:hover:bg-navy-lighter/60 transition-colors cursor-pointer">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M7 18l6-6-6-6"/></svg>
          Tags
        </button>
        <div id="tagDropdown" class="hidden absolute left-0 top-full mt-1 w-40 rounded-xl p-1.5 z-50 bg-white dark:bg-navy-light shadow-lg dark:shadow-xl border border-sage-pale dark:border-navy-lighter">
        </div>
      </div>
      <div id="activeTagPills" class="flex flex-wrap gap-1.5"></div>
      <div class="w-px h-5 bg-sage-pale dark:bg-navy-lighter/50 mx-1"></div>
      <span class="text-[10.5px] font-semibold uppercase tracking-wider text-slate dark:text-sage-light mr-1">Date:</span>
      <input id="filterDate" type="date"
        class="text-xs px-2.5 py-1.5 rounded-lg outline-none transition-all
        bg-mint/50 dark:bg-navy-lighter/50 text-navy dark:text-mint
        border border-sage-pale dark:border-navy-lighter/50
        focus:border-sage focus:ring-2 focus:ring-sage/15 cursor-pointer" />
      <div class="w-px h-5 bg-sage-pale dark:bg-navy-lighter/50 mx-1"></div>
      <input id="filterProject" type="text" placeholder="Project" list="projectList"
        class="text-xs px-2.5 py-1.5 rounded-lg outline-none transition-all w-28
        bg-mint/50 dark:bg-navy-lighter/50 text-navy dark:text-mint
        border border-sage-pale dark:border-navy-lighter/50
        focus:border-sage focus:ring-2 focus:ring-sage/15 cursor-pointer" />
      <datalist id="projectList"></datalist>
      <button id="filterClear" class="text-[10px] font-medium px-2 py-1 rounded-lg bg-mint dark:bg-navy-lighter/40
        text-slate dark:text-sage-light hover:bg-sage-pale dark:hover:bg-navy-lighter/60 transition-colors cursor-pointer">
        Clear
      </button>
    </div>
  </div>

  <!-- Content -->
  <main class="flex-1 flex flex-col min-h-0">
    <!-- List View -->
    <section id="listView" class="view-panel flex flex-col gap-1.5 flex-1 min-h-0 overflow-y-auto w-full">
      <div id="todoList" class="grid w-full h-full"></div>
    </section>

    <!-- Kanban View -->
    <section id="kanbanView" class="view-panel hidden flex-1 min-h-0 overflow-hidden w-full">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3 h-full" id="kanbanBoard">
        <!-- To Do -->
        <div class="col-drop rounded-2xl p-3.5 bg-sage-pale/40 dark:bg-navy-light/60 border border-sage-pale/80 dark:border-navy-lighter/40 flex flex-col min-h-0"
          data-status="todo">
          <div class="flex items-center justify-between mb-3 pb-2.5 border-b border-sage-pale dark:border-navy-lighter/40 flex-shrink-0">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-amber-400"></span>
              <span class="text-[11px] font-semibold uppercase tracking-wider text-navy dark:text-mint-light">To Do</span>
            </div>
            <span id="cTodo" class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-white dark:bg-navy text-slate dark:text-sage-light">0</span>
          </div>
          <div id="kTodo" class="flex flex-col gap-2.5 min-h-[50px] overflow-y-auto flex-1"></div>
          <button data-add-status="todo"
            class="mt-2.5 w-full py-2.5 rounded-xl text-[11px] font-medium text-slate dark:text-sage-dark
            border border-dashed border-sage-pale dark:border-navy-lighter/50
            hover:bg-white dark:hover:bg-navy-lighter/40 hover:text-navy dark:hover:text-sage
            transition-colors cursor-pointer flex items-center justify-center gap-1.5 flex-shrink-0">
            <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
            Add
          </button>
        </div>
        <!-- In Progress -->
        <div class="col-drop rounded-2xl p-3.5 bg-sage-pale/40 dark:bg-navy-light/60 border border-sage-pale/80 dark:border-navy-lighter/40 flex flex-col min-h-0"
          data-status="progress">
          <div class="flex items-center justify-between mb-3 pb-2.5 border-b border-sage-pale dark:border-navy-lighter/40 flex-shrink-0">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-sage"></span>
              <span class="text-[11px] font-semibold uppercase tracking-wider text-navy dark:text-mint-light">In Progress</span>
            </div>
            <span id="cProg" class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-white dark:bg-navy text-slate dark:text-sage-light">0</span>
          </div>
          <div id="kProg" class="flex flex-col gap-2.5 min-h-[50px] overflow-y-auto flex-1"></div>
          <button data-add-status="progress"
            class="mt-2.5 w-full py-2.5 rounded-xl text-[11px] font-medium text-slate dark:text-sage-dark
            border border-dashed border-sage-pale dark:border-navy-lighter/50
            hover:bg-white dark:hover:bg-navy-lighter/40 hover:text-navy dark:hover:text-sage
            transition-colors cursor-pointer flex items-center justify-center gap-1.5 flex-shrink-0">
            <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
            Add
          </button>
        </div>
        <!-- Done -->
        <div class="col-drop rounded-2xl p-3.5 bg-sage-pale/40 dark:bg-navy-light/60 border border-sage-pale/80 dark:border-navy-lighter/40 flex flex-col min-h-0"
          data-status="done">
          <div class="flex items-center justify-between mb-3 pb-2.5 border-b border-sage-pale dark:border-navy-lighter/40 flex-shrink-0">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              <span class="text-[11px] font-semibold uppercase tracking-wider text-navy dark:text-mint-light">Done</span>
            </div>
            <span id="cDone" class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-white dark:bg-navy text-slate dark:text-sage-light">0</span>
          </div>
          <div id="kDone" class="flex flex-col gap-2.5 min-h-[50px] overflow-y-auto flex-1"></div>
          <button data-add-status="done"
            class="mt-2.5 w-full py-2.5 rounded-xl text-[11px] font-medium text-slate dark:text-sage-dark
            border border-dashed border-sage-pale dark:border-navy-lighter/50
            hover:bg-white dark:hover:bg-navy-lighter/40 hover:text-navy dark:hover:text-sage
            transition-colors cursor-pointer flex items-center justify-center gap-1.5 flex-shrink-0">
            <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
            Add
          </button>
        </div>
      </div>
    </section>

    <!-- Graph View -->
    <section id="graphView" class="view-panel hidden flex-1 min-h-0 overflow-hidden w-full">
      <div class="flex items-center gap-2 mb-3">
        <span id="graphStats" class="text-[11px] font-medium text-slate dark:text-sage-dark">
          <span id="entityCount" class="text-navy dark:text-sage font-semibold">0</span> entities ·
          <span id="edgeCount" class="text-navy dark:text-sage font-semibold">0</span> connections
        </span>
      </div>
      <div id="graphContainer" class="rounded-2xl border border-sage-pale/60 dark:border-navy-lighter/30 bg-white dark:bg-navy-light" style="height: calc(100% - 24px); min-height: 400px;"></div>
    </section>

    <!-- Chat View -->
    <section id="chatView" class="view-panel hidden flex-1 min-h-0 overflow-hidden w-full flex flex-col">
      <div class="flex items-center gap-2 mb-3">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-sage dark:text-sage-light"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate dark:text-sage-light">Chat with Kakka</span>
        <span class="text-[10px] text-slate/50 dark:text-sage-dark/50">· Powered by Ollama</span>
      </div>
      <div id="chatMessages" class="flex-1 overflow-y-auto rounded-2xl border border-sage-pale/60 dark:border-navy-lighter/30 bg-white dark:bg-navy-light p-4 flex flex-col gap-3 min-h-0">
        <div class="flex items-center justify-center h-full text-sm text-slate/40 dark:text-sage-dark/40">
          <div class="text-center">
            <svg class="mx-auto mb-3 opacity-30" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            <p class="font-medium">Ask Kakka anything</p>
            <p class="text-xs mt-1">Your tasks and knowledge graph are loaded automatically</p>
          </div>
        </div>
      </div>
      <div class="mt-3 flex gap-2">
        <input id="chatInput" type="text" placeholder="Type a message..."
          class="flex-1 px-4 py-2.5 rounded-xl text-sm outline-none transition-all
          bg-mint/50 dark:bg-navy-lighter/50 text-navy dark:text-mint
          border border-sage-pale dark:border-navy-lighter/50
          focus:border-sage focus:ring-2 focus:ring-sage/15
          placeholder:text-slate/40 dark:placeholder:text-sage-dark/40" />
        <button id="chatSend"
          class="px-4 py-2.5 rounded-xl bg-sage text-navy hover:bg-sage-dark transition-colors cursor-pointer
          shadow-sm shadow-sage/15 flex items-center gap-1.5 text-sm font-medium disabled:opacity-50 disabled:cursor-not-allowed">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          Send
        </button>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="mt-4 pt-4 border-t border-sage-pale dark:border-navy-lighter/40">
    <p class="text-center text-[11px] text-slate/60 dark:text-sage-dark/50 flex items-center justify-center gap-1.5">
      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
      Organize your day, one task at a time.
    </p>
  </footer>
</div>

<!-- Description Preview Overlay -->
<div id="descOverlay" class="modal-bg hidden fixed inset-0 z-[100] flex items-center justify-center p-4
  bg-navy/20 dark:bg-black/40 backdrop-blur-sm">
  <div class="modal-box w-full max-w-lg rounded-2xl p-5
    bg-white dark:bg-navy-light shadow-xl
    border border-sage-pale dark:border-navy-lighter/40">
    <div class="flex items-center justify-between mb-3">
      <h2 id="descOverlayTitle" class="text-sm font-bold text-navy dark:text-mint">Description</h2>
      <button id="descOverlayClose" aria-label="Close"
        class="w-7 h-7 rounded-lg bg-mint dark:bg-navy-lighter text-slate dark:text-sage-dark
        flex items-center justify-center text-xs hover:bg-red-50 dark:hover:bg-red-500/10 hover:text-red-400 dark:hover:text-red-300
        transition-colors cursor-pointer">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div id="descOverlayContent" class="text-sm text-navy dark:text-mint leading-relaxed max-h-[60vh] overflow-y-auto"></div>
    <div class="flex justify-end gap-2 mt-4 pt-3 border-t border-sage-pale dark:border-navy-lighter/40">
      <button id="descOverlayClose2"
        class="text-xs font-medium px-4 py-2 rounded-lg cursor-pointer transition-colors
        text-slate dark:text-sage-light bg-mint/50 dark:bg-navy-lighter/40
        hover:bg-sage-pale dark:hover:bg-navy-lighter/60">Close</button>
      <button id="descOverlayEdit"
        class="text-xs font-medium px-4 py-2 rounded-lg bg-sage text-navy hover:bg-sage-dark
        transition-colors cursor-pointer shadow-sm shadow-sage/15">Edit</button>
    </div>
  </div>
</div>

<!-- Modal -->
<div id="modalBg" class="modal-bg hidden fixed inset-0 z-[100] flex items-center justify-center p-4
  bg-navy/20 dark:bg-black/40 backdrop-blur-sm">
  <div class="modal-box w-full max-w-md rounded-2xl p-5
    bg-white dark:bg-navy-light shadow-xl
    border border-sage-pale dark:border-navy-lighter/40">
    <div class="flex items-center justify-between mb-5">
      <h2 id="modalTitle" class="text-sm font-bold text-navy dark:text-mint">New Task</h2>
      <button id="modalClose" aria-label="Close"
        class="w-7 h-7 rounded-lg bg-mint dark:bg-navy-lighter text-slate dark:text-sage-dark
        flex items-center justify-center text-xs hover:bg-red-50 dark:hover:bg-red-500/10 hover:text-red-400 dark:hover:text-red-300
        transition-colors cursor-pointer">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <form id="taskForm" class="flex flex-col gap-4">
      <div>
        <label class="block text-[10.5px] font-semibold uppercase tracking-wider mb-1.5 text-slate dark:text-sage-light">Title</label>
        <input id="fTitle" type="text" required placeholder="What needs to be done?"
          class="w-full px-3.5 py-2.5 rounded-xl text-sm outline-none transition-all
          bg-mint/50 dark:bg-navy-lighter/50 text-navy dark:text-mint
          border border-sage-pale dark:border-navy-lighter/50
          focus:border-sage focus:ring-2 focus:ring-sage/15
          placeholder:text-slate/40 dark:placeholder:text-sage-dark/40" />
      </div>
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label class="block text-[10.5px] font-semibold uppercase tracking-wider text-slate dark:text-sage-light">Description</label>
          <button type="button" id="mdPreviewBtn" class="text-[10px] font-medium text-slate dark:text-sage-light hover:text-navy dark:hover:text-mint transition-colors cursor-pointer">Preview</button>
        </div>
        <textarea id="fDesc" rows="2" placeholder="Add details (optional). **bold**, *italic*, `code`"
